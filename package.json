{
  "name": "dsh-prompt-for-me",
  "version": "1.0.0",
  "description": "Prompt optimizer for DeepSeek Harness: improves composer drafts with an editable local template.",
  "type": "commonjs",
  "main": "lib/index.cjs",
  "exports": {
    ".": "./lib/index.cjs",
    "./client": "./lib/client.cjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "node --test",
    "check": "npm run build && npm test && npm pack --dry-run --cache .npm-cache"
  },
  "dsh": {
    "displayName": "嘴替",
    "description": "设计下一条开发提示词，或优化当前草稿。",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings-general": ">=0.2.0-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings-general": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "prompt",
    "composer",
    "copilot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XXXXXQ-0206/dsh-prompt-for-me.git"
  },
  "homepage": "https://github.com/XXXXXQ-0206/dsh-prompt-for-me#readme",
  "bugs": {
    "url": "https://github.com/XXXXXQ-0206/dsh-prompt-for-me/issues"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT"
}
